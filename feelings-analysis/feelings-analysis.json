{
  "name": "feelings-analysis",
  "nodes": [
    {
      "parameters": {
        "content": "## Agente de feedbacks de clientes\n\nEste flujo se utiliza para analizar todos los comentarios de los clientes y pasarlos por los siguientes nodos:\n- Analisis de sentimientos\n- Clasificacion del comentario al o los equipos de trabajo\n- Solo para los comentarios negativos va a crear un plan de accion",
        "height": 240,
        "width": 416
      },
      "type": "n8n-nodes-base.stickyNote",
      "typeVersion": 1,
